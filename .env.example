# Copia este archivo a ".env" (en la misma carpeta que manage.py) y ajusta los valores.
# El archivo .env NO se sube a Git.

# --- Base de datos (PostgreSQL local) ---
DB_NAME=petsalert
DB_USER=petsalert
DB_PASSWORD=cambia_esto
DB_HOST=127.0.0.1
# 5432 es el puerto por defecto; revisa el tuyo en pgAdmin (Properties > Connection).
DB_PORT=5432

# --- Seguridad ---
DEBUG=True
# Genera una clave propia para producción. En desarrollo puedes dejarla vacía.
SECRET_KEY=
# Hosts permitidos separados por comas (para probar desde el celular agrega la IP de tu equipo).
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# --- Correo ---
# Si dejas EMAIL_HOST vacío, los correos (verificación y recuperar contraseña)
# se imprimen en la terminal donde corre "python manage.py runserver".
DEFAULT_FROM_EMAIL=Pets Alert <no-reply@petsalert.local>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
